{
  "name": "classcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "eval:hints": "node --experimental-strip-types scripts/evaluate-hints.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "lighthouse http://127.0.0.1:3011 --output=json --output-path=artifacts/lighthouse-mobile.json --only-categories=performance,accessibility,best-practices,seo --chrome-flags=\"--headless --no-sandbox\" && node scripts/check-lighthouse.mjs"
  },
  "type": "module",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yjs": "^13.6.33"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.6.0"
  }
}
