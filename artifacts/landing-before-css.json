  "animations": [
    {
      "name": "companion-blink",
      "css": "@keyframes companion-blink { \n  0%, 43%, 47%, 100% { transform: scaleY(1); }\n  45% { transform: scaleY(0.12); }\n}"
    },
    {
      "name": "companion-float",
      "css": "@keyframes companion-float { \n  0%, 100% { transform: translateY(0px) rotate(-3deg); }\n  50% { transform: translateY(-5px) rotate(3deg); }\n}"
    },
    {
      "name": "auth-spin",
      "css": "@keyframes auth-spin { \n  100% { transform: rotate(360deg); }\n}"
    },
    {
      "name": "surface-enter",
      "css": "@keyframes surface-enter { \n  0% { opacity: 0; transform: translateY(5px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}"
    },
    {
      "name": "dialog-enter",
      "css": "@keyframes dialog-enter { \n  0% { opacity: 0; transform: translateY(7px) scale(0.985); }\n  100% { opacity: 1; transform: translateY(0px) scale(1); }\n}"
    },
    {
      "name": "backdrop-enter",
      "css": "@keyframes backdrop-enter { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
    },
    {
      "name": "run-breathe",
      "css": "@keyframes run-breathe { \n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.45; }\n}"
    },
    {
      "name": "loading-turn",
      "css": "@keyframes loading-turn { \n  100% { transform: rotate(360deg); }\n}"
    },
    {
      "name": "live-pulse",
      "css": "@keyframes live-pulse { \n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.5; }\n}"
    },
    {
      "name": "hint-enter",
      "css": "@keyframes hint-enter { \n  0% { opacity: 0; transform: translateY(5px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}"
    },
    {
      "name": "toast-enter",
      "css": "@keyframes toast-enter { \n  0% { opacity: 0; transform: translateY(12px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}"
    },
    {
      "name": "overlay-in",
      "css": "@keyframes overlay-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
    },
    {
      "name": "modal-in",
      "css": "@keyframes modal-in { \n  0% { opacity: 0; transform: scale(0.96); }\n  100% { opacity: 1; transform: scale(1); }\n}"
    },
    {
      "name": "card-in",
      "css": "@keyframes card-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
    },
    {
      "name": "reveal-in",
      "css": "@keyframes reveal-in { \n  0% { opacity: 0; transform: translateY(12px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}"
    },
    {
      "name": "caret-blink",
      "css": "@keyframes caret-blink { \n  50% { opacity: 0; }\n}"
    },
    {
      "name": "scan-line",
      "css": "@keyframes scan-line { \n  0% { opacity: 0; transform: translateY(-100%); }\n  18% { opacity: 0.85; }\n  100% { opacity: 0; transform: translateY(100%); }\n}"
    },
    {
      "name": "check-draw",
      "css": "@keyframes check-draw { \n  100% { stroke-dashoffset: 0; }\n}"
    },
    {
      "name": "token-highlight",
      "css": "@keyframes token-highlight { \n  0% { background-position: 100% 0px; }\n  100% { background-position: 0px 0px; }\n}"
    },
    {
      "name": "skeleton-wash",
      "css": "@keyframes skeleton-wash { \n  100% { background-position: -220% 0px; }\n}"
    },
    {
      "name": "spin",
      "css": "@keyframes spin { \n  100% { transform: rotate(360deg); }\n}"
    },
    {
      "name": "step-arrive",
      "css": "@keyframes step-arrive { \n  0% { opacity: 0; transform: translateY(8px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}"
    },
    {
      "name": "code-progress",
      "css": "@keyframes code-progress { \n  0%, 100% { opacity: 0.55; }\n  50% { opacity: 1; }\n}"
    },
    {
      "name": "share-flow",
      "css": "@keyframes share-flow { \n  0%, 100% { opacity: 0.55; }\n  50% { opacity: 1; }\n}"
    },
    {
      "name": "particle-burst",
      "css": "@keyframes particle-burst { \n  0% { opacity: 0.9; transform: rotate(var(--particle-angle)) translateY(0) scale(.2); }\n  100% { opacity: 0; transform: rotate(var(--particle-angle)) translateY(-16px) scale(1); }\n}"
    },
    {
      "name": "fade-in",
      "css": "@keyframes fade-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
    },
    {
      "name": "dialog-enter",
      "css": "@keyframes dialog-enter { \n  0% { opacity: 0; transform: scale(0.96); }\n  100% { opacity: 1; transform: scale(1); }\n}"
    }
  ]
